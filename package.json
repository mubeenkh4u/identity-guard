{
  "name": "identity-guard",
  "version": "0.2.2",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "expo start",
    "dev:server": "node --watch server/src/index.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:web": "npm run build",
    "package:hostinger": "npm run build && node scripts/prepare-hostinger.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "~54.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-router": "~6.0.0",
    "express": "^5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}

{
  "expo": {
    "name": "Identity Guard",
    "slug": "identity-guard",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "identityguard",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-image-picker"],
    "web": {
